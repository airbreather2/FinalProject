# Load required libraries
library(ggplot2)
library(plotly)
library(reshape2)
library(viridis)
# Example 1: Basic contour plot using base R
basic_contour_base <- function() {
# Create a grid of points
x <- seq(-3, 3, length.out = 100)
y <- seq(-3, 3, length.out = 100)
# Create function values (2D Gaussian)
z <- outer(x, y, function(x, y) exp(-(x^2 + y^2) / 2))
# Basic contour plot
contour(x, y, z,
main = "Basic Contour Plot (Base R)",
xlab = "X", ylab = "Y",
col = "blue", lwd = 2)
# Add filled contours
filled.contour(x, y, z,
main = "Filled Contour Plot (Base R)",
xlab = "X", ylab = "Y",
color.palette = rainbow)
}
# Example 2: ggplot2 contour plot
ggplot_contour <- function() {
# Create data frame
x <- seq(-3, 3, length.out = 100)
y <- seq(-3, 3, length.out = 100)
grid <- expand.grid(x = x, y = y)
grid$z <- exp(-(grid$x^2 + grid$y^2) / 2)
# ggplot2 contour plot
p1 <- ggplot(grid, aes(x = x, y = y, z = z)) +
geom_contour(aes(color = after_stat(level)), bins = 15, size = 1) +
scale_color_viridis_c(name = "Level") +
labs(title = "Contour Plot with ggplot2",
x = "X", y = "Y") +
theme_minimal()
# Filled contour plot
p2 <- ggplot(grid, aes(x = x, y = y, z = z)) +
geom_contour_filled(bins = 15) +
geom_contour(color = "white", alpha = 0.5, bins = 15) +
scale_fill_viridis_d(name = "Level") +
labs(title = "Filled Contour Plot with ggplot2",
x = "X", y = "Y") +
theme_minimal()
print(p1)
print(p2)
}
# Example 3: Complex function with custom styling
advanced_contour <- function() {
# Create more complex function
x <- seq(-2, 2, length.out = 200)
y <- seq(-2, 2, length.out = 200)
grid <- expand.grid(x = x, y = y)
grid$z <- sin(grid$x^2 + grid$y^2) * exp(-0.1 * (grid$x^2 + grid$y^2))
# Advanced ggplot2 contour
p <- ggplot(grid, aes(x = x, y = y, z = z)) +
geom_contour_filled(bins = 20, alpha = 0.8) +
geom_contour(color = "black", size = 0.3, bins = 20) +
scale_fill_gradient2(low = "blue", mid = "white", high = "red",
midpoint = 0, name = "Value") +
labs(title = "Advanced Contour Plot",
subtitle = "sin(x² + y²) × exp(-0.1(x² + y²))",
x = "X", y = "Y") +
theme_minimal() +
theme(panel.grid = element_blank())
print(p)
}
# Example 4: 3D interactive contour with plotly
interactive_3d_contour <- function() {
# Create data
x <- seq(-5, 5, length.out = 50)
y <- seq(-5, 5, length.out = 50)
z_matrix <- outer(x, y, function(x, y) sin(sqrt(x^2 + y^2)))
# Create 3D surface plot with contours
p <- plot_ly(x = x, y = y, z = z_matrix, type = "surface",
contours = list(
z = list(show = TRUE, start = -1, end = 1, size = 0.2),
x = list(show = TRUE),
y = list(show = TRUE)
)) %>%
layout(title = "3D Interactive Contour Plot",
scene = list(xaxis = list(title = "X"),
yaxis = list(title = "Y"),
zaxis = list(title = "Z")))
print(p)
}
# Example 5: Real-world application - Temperature data
temperature_contour <- function() {
# Simulate temperature data
set.seed(42)
x <- seq(0, 10, length.out = 50)
y <- seq(0, 8, length.out = 40)
grid <- expand.grid(x = x, y = y)
# Simulate temperature with heat sources
grid$temp <- 20 +
15 * exp(-((grid$x - 3)^2 + (grid$y - 2)^2) / 4) +
10 * exp(-((grid$x - 7)^2 + (grid$y - 6)^2) / 3) +
rnorm(nrow(grid), 0, 1)
# Temperature contour map
p <- ggplot(grid, aes(x = x, y = y, z = temp)) +
geom_contour_filled(breaks = seq(15, 40, by = 2), alpha = 0.8) +
geom_contour(breaks = seq(15, 40, by = 2), color = "black", size = 0.3) +
scale_fill_viridis_d(name = "Temp (°C)", option = "plasma") +
labs(title = "Temperature Distribution Contour Map",
x = "Distance (km)", y = "Distance (km)") +
theme_minimal() +
theme(panel.grid = element_blank())
print(p)
}
# Example 6: Contour plot with volcano dataset (built-in R data)
volcano_contour <- function() {
# Use built-in volcano dataset
# Convert to long format for ggplot2
volcano_long <- melt(volcano)
names(volcano_long) <- c("x", "y", "elevation")
# Create contour plot
p1 <- ggplot(volcano_long, aes(x = x, y = y, z = elevation)) +
geom_contour_filled(bins = 20) +
geom_contour(color = "white", alpha = 0.5, bins = 20) +
scale_fill_viridis_d(name = "Elevation") +
labs(title = "Volcano Elevation Contours",
x = "X coordinate", y = "Y coordinate") +
theme_minimal()
# Alternative with base R
contour(volcano, main = "Volcano Contours (Base R)")
print(p1)
}
# Example 7: Statistical application - 2D density contours
density_contour <- function() {
# Generate correlated data
set.seed(123)
n <- 1000
x <- rnorm(n)
y <- 0.5 * x + rnorm(n, 0, 0.8)
# 2D density contour
p <- ggplot(data.frame(x = x, y = y), aes(x = x, y = y)) +
geom_point(alpha = 0.3, size = 0.5) +
geom_density_2d_filled(alpha = 0.6, bins = 15) +
geom_density_2d(color = "white", size = 0.5, bins = 15) +
scale_fill_viridis_d(name = "Density") +
labs(title = "2D Density Contours",
x = "X variable", y = "Y variable") +
theme_minimal()
print(p)
}
# Run examples
cat("Running R contour plot examples...\n")
# Uncomment the examples you want to run:
basic_contour_base()
x <- rnorm(100)
y <- rnorm(100)
x <- rnorm(100)
y <- rnorm(100)
plot(x, y)
x <- seq(1,10)
x
x <- 1:10
x
y <- x
f <- outer(x, y, function(x,y) cos(y) / (1 +x^2))
contour(x, y, f)
contour(x, y, f, nlevels = 45, add = T)
#some code
# Set y equal to x - this creates identical coordinate vectors
# If x is seq(-3, 3, length.out=100), then y will be the same
y <- x
# outer() applies the function to every combination of x[i] and y[j]
# This creates a matrix f where f[i,j] = cos(y[j]) / (1 + x[i]^2)
# - cos(y) creates sinusoidal oscillations along the y-direction
# - (1 + x^2) in denominator creates a "bell curve" effect along x-direction
# - The result is oscillating ridges that decay as you move away from x=0
f <- outer(x, y, function(x,y) cos(y) / (1 + x^2))
# First contour plot with default settings (~10 contour levels)
# This establishes the plot area and draws the basic contour structure
contour(x, y, f)
fa <- (f- t(f))/ 2)
fa <- (f- t(f))/ 2
contour(x, y, fa, nlevels = 15)
image(x, y, fa)
persp(x, y, fa)
persp(x, y, fa, theta = 30)
persp(x, y, fa, theta = 30, phi = 20)
persp(x, y, fa, theta = 30, phi = 70)
persp(x, y, fa, theta = 30, phi = 40)
