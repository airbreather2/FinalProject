MoransItest <- function(group_name) {
group_data <- wheat_rf %>% filter(group == group_name)
result <- easy_morans_test(
data = wheat_rf,
yield_col = "Grain.yield..tons.ha.1.",
lon_col = "Conversion.for.longitude",
lat_col = "Conversion.for.latitude"
)
return(result)
}
