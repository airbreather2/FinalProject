var_prefix = "temp"
)
library(terra)
library(dplyr)
# Load trial data
dat <- read.csv("../../../../data/finaldatasets/testdata/jittered_treedata.csv")
library(terra)
library(dplyr)
extract_weather_variable <- function(df, nc_path,
var_prefix = "x",  # e.g. "t" or "p"
lon_col = "longitude_jittered",
lat_col = "latitude_jittered",
id_col = "id",
year_col = "Observation.period",
start_col = "start_date",
end_col = "end_date",
window_length = 9) {
# Step 1: Compute sowing year
df$sowing_year <- ifelse(df[[start_col]] > df[[end_col]],
df[[year_col]] - 1,
df[[year_col]])
# Step 2: Load raster
r <- terra::rast(nc_path)
all_dates <- seq(as.Date("1979-01-01"), by = "month", length.out = terra::nlyr(r))
var_names <- paste0(var_prefix, format(all_dates, "%m-%Y"))
# Step 3: Extract raster values at coordinates
coords <- df[, c(lon_col, lat_col)]
var_vals <- bind_cols(id = df[[id_col]], terra::extract(r, coords)[, -1])
colnames(var_vals)[-1] <- var_names
# Step 4: Define window function
generate_window <- function(year, month) {
start <- as.Date(sprintf("%d-%02d-01", year, month))
seq(start, by = "month", length.out = window_length)
}
# Step 5: Extract rows
get_row <- function(i) {
row <- df[i, ]
win <- generate_window(row$sowing_year, row[[start_col]])
var_cols <- paste0(var_prefix, format(win, "%m-%Y"))
vals <- as.numeric(var_vals[var_vals$id == row[[id_col]], var_cols])
# Explicitly return a named vector, not a list
result <- c(id = row[[id_col]],
sowing_year = row$sowing_year,
setNames(vals, paste0(var_prefix, 1:window_length)))
return(unlist(result))
}
# Step 6: Assemble result
out <- do.call(rbind, lapply(1:nrow(df), get_row)) %>% as.data.frame()
out[, -c(1, 2)] <- lapply(out[, -c(1, 2)], as.numeric)
return(out)
}
