library(gstat)
library(sp)
library(spacetime)
############################Create subset for datacleaning ####################
df <- read.csv("../../../../data/finaldatasets/testdata/xgboost.csv")
df_clean <- na.omit(df[, c("Conversion.for.longitude",
"Conversion.for.latitude",
"year",
"Grain.yield..tons.ha.1.")])
names(df_clean) <- c("lon", "lat", "year", "yield")
df_clean <- df_clean[sample(nrow(df_clean), size = 10000), ]
# Spatial points
coords <- SpatialPoints(df_clean[, c("lon", "lat")], proj4string = CRS("+proj=longlat +datum=WGS84"))
# Time: convert year to Date (fake date for time spacing)
time_vals <- as.Date(paste0(df_clean$year, "-01-01"))
# Make a STIDF (spacetime data frame)
stidf <- STIDF(coords, time_vals, data = data.frame(yield = df_clean$yield))
# Define spatial and temporal binning
vg_st <- variogramST(yield ~ 1, data = stidf,
assumeRegular = FALSE,
width = 50,
tlags = seq(0, 5 * 365, by = 365)  # lags at 0, 1 year, 2 years, ..., 5 years)            # temporal lags (years)
)
