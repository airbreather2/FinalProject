filter(
Grain.yield..tons.ha.1. <= 30,  # Remove unrealistic yields
Observation.period >= 1990,     # Keep reasonable years
nchar(as.character(Observation.period)) == 4
)
# Select variables and clean data in one pipeline
wheat_rf <- wheat1 %>%
select(
# Core variables
Country, Location, Continent, Observation.period,
Conversion.for.latitude, Conversion.for.longitude,
Grain.yield..tons.ha.1., unit_code, pr_irrigated, Elevation,
# Climate data (complete variables)
temp1, temp2, temp3, temp4, temp5, temp6, temp7, temp8, temp9,
prc1, prc2, prc3, prc4, prc5, prc6, prc7, prc8, prc9,
# Additional variables (some missing data)
AEZ, Climate, State.Region.County.Province, Soil.pH, Sand, Silt, Clay
) %>%
drop_na(Grain.yield..tons.ha.1.) %>%  # Remove missing yields
na.omit() %>%  # Remove rows with any missing predictors
filter(
Grain.yield..tons.ha.1. <= 30,  # Remove unrealistic yields
Observation.period >= 1990,     # Keep reasonable years
)
View(wheat_rf)
